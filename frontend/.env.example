# URL pública del backend. En desarrollo no hace falta: por defecto apunta a
# http://127.0.0.1:8000
VITE_API_URL=

# Clave compartida de la API. Debe coincidir con la API_KEY del backend.
#
# OJO: Vite incrusta las variables VITE_* en el bundle, así que esta clave es
# visible para cualquiera que abra las herramientas de desarrollo. Frena el
# abuso de paso, no a alguien decidido. Para eso hacen falta cuentas de verdad.
VITE_API_KEY=

# ---------------------------------------------------------------- cuentas
# Proyecto de Supabase. Sin esto no hay login, ni historial, ni documentos:
# la aplicación arranca en modo suelto y el chat funciona igual.
#
# Solo la clave `anon`. La `service_role` salta row level security y no debe
# aparecer nunca en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
