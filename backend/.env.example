# Copia este archivo a .env y coloca tu clave de Google AI Studio.
GOOGLE_API_KEY=

# Orígenes permitidos por CORS, separados por comas. Sin definir, se permite
# solo el servidor de desarrollo de Vite (localhost:5173).
# ALLOWED_ORIGINS=https://mi-frontend.vercel.app

# Clave compartida que exige la API en la cabecera X-API-Key.
#
# Sin definir, la API queda ABIERTA: correcto en local, no para un despliegue
# accesible desde internet. El frontend la manda desde su propia VITE_API_KEY,
# que debe valer lo mismo.
#
# Genera una con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# Límite por IP: peticiones permitidas por ventana, y tamaño de la ventana en
# segundos. Por defecto 30 peticiones / 60 s.
# RATE_LIMIT_PETICIONES=30
# RATE_LIMIT_VENTANA=60
