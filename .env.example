# Copia este archivo a .env y coloca tus claves. El .env NO se versiona.

# ------------------------------------------------------------------ modelo
# Google AI Studio. Cada persona usa la suya.
GOOGLE_API_KEY=

# ---------------------------------------------------------------- cuentas
# Opcional. Sin esto la aplicación funciona igual que siempre: hay chat, y no
# hay login, historial ni documentos del usuario.
#
# El proyecto se crea en supabase.com y se ejecutan, en su editor SQL y en
# este orden, backend/supabase/001_historial.sql y 002_documentos.sql.
#
# Solo la clave `anon`, nunca la `service_role`: la de servicio salta row
# level security por diseño y no debe salir del panel de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Las mismas dos, para el frontend. Vite solo expone al navegador lo que
# empieza por VITE_, así que van repetidas a propósito.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------- clave compartida
# Protege la cuota del modelo frente a quien dé con la URL. Convive con las
# cuentas: no es lo mismo "este despliegue acepta peticiones" que "quién eres".
# En local se deja vacía.
API_KEY=
